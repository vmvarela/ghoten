new file mode 100644
--- /dev/null
+++ b/internal/command/history.go
@@ -0,0 +1,272 @@
+package command
+
+import (
+	"bytes"
+	"context"
+	"encoding/json"
+	"fmt"
+	"os"
+	"strconv"
+	"strings"
+	"time"
+
+	"github.com/mitchellh/cli"
+	"github.com/opentofu/opentofu/internal/command/arguments"
+	"github.com/opentofu/opentofu/internal/states/statemgr"
+)
+
+type HistoryCommand struct{}
+
+func (c *HistoryCommand) Run(_ []string) int { return cli.RunResultHelp }
+func (c *HistoryCommand) Synopsis() string   { return "Inspect retained ORAS state history" }
+func (c *HistoryCommand) Help() string {
+	return strings.TrimSpace(`
+Usage: tofu [global options] history <subcommand> [options]
+
+  Inspect retained state versions when the active backend exposes the optional
+  read-only history capability.
+
+Subcommands:
+  list    List retained versions
+  show    Show one retained state version
+  pull    Write one retained state version to a file
+`)
+}
+
+func normalizeHistoryArgs(args []string) []string {
+	normalized := append([]string(nil), args...)
+	for i, arg := range normalized {
+		if arg == "--" {
+			break
+		}
+		if strings.HasPrefix(arg, "--") {
+			normalized[i] = "-" + strings.TrimPrefix(arg, "--")
+		}
+	}
+	return normalized
+}
+
+func HistoryListCommander() Command {
+	cmd := Command{Name: "list", Short: "List retained state versions", Long: "List retained versions for the current workspace."}
+	args := arguments.BindHistoryList(&cmd.CommandLine)
+	cmd.Run = func(meta Meta) int { return HistoryListCommand{Meta: meta}.Execute(args) }
+	return cmd
+}
+
+type HistoryListCommand struct{ Meta }
+
+func (c *HistoryListCommand) Synopsis() string { return "List retained state versions" }
+func (c *HistoryListCommand) Help() string {
+	return strings.TrimSpace(`
+Usage: tofu [global options] history list [-json]
+
+  List retained versions for the current workspace. State contents are never
+  printed by this command.
+`)
+}
+func (c *HistoryListCommand) Run(rawArgs []string) int {
+	return RunCommand(HistoryListCommander(), c.Meta, normalizeHistoryArgs(rawArgs))
+}
+func (c HistoryListCommand) Execute(args *arguments.HistoryList) int {
+	ctx, history, err := loadStateHistory(c.Meta)
+	if err != nil {
+		return historyCommandError(err)
+	}
+	versions, err := history.ListVersions(ctx)
+	if err != nil {
+		return historyCommandError(err)
+	}
+
+	if args.JSON {
+		enc := json.NewEncoder(os.Stdout)
+		enc.SetIndent("", "  ")
+		if err := enc.Encode(versions); err != nil {
+			return historyCommandError(err)
+		}
+		return 0
+	}
+
+	fmt.Fprintln(os.Stdout, "VERSION\tUPDATED\tDIGEST")
+	for _, version := range versions {
+		updated := "-"
+		if !version.UpdatedAt.IsZero() {
+			updated = version.UpdatedAt.UTC().Format(time.RFC3339)
+		}
+		fmt.Fprintf(os.Stdout, "%d\t%s\t%s\n", version.Version, updated, version.Digest)
+	}
+	return 0
+}
+
+func HistoryShowCommander() Command {
+	cmd := Command{Name: "show", Short: "Show a retained state version", Long: "Show one retained version for the current workspace."}
+	args := arguments.BindHistoryShow(&cmd.CommandLine)
+	cmd.Run = func(meta Meta) int { return HistoryShowCommand{Meta: meta}.Execute(args) }
+	return cmd
+}
+
+type HistoryShowCommand struct{ Meta }
+
+func (c *HistoryShowCommand) Synopsis() string { return "Show a retained state version" }
+func (c *HistoryShowCommand) Help() string {
+	return strings.TrimSpace(`
+Usage: tofu [global options] history show [-json] <version>
+
+  Show one retained version for the current workspace. -json writes the
+  historical state JSON without the human-readable metadata header.
+`)
+}
+func (c *HistoryShowCommand) Run(rawArgs []string) int {
+	return RunCommand(HistoryShowCommander(), c.Meta, normalizeHistoryArgs(rawArgs))
+}
+func (c HistoryShowCommand) Execute(args *arguments.HistoryShow) int {
+	version, err := parseHistoryVersion(args.Version)
+	if err != nil {
+		return historyCommandError(err)
+	}
+	ctx, history, err := loadStateHistory(c.Meta)
+	if err != nil {
+		return historyCommandError(err)
+	}
+	data, err := history.GetVersion(ctx, version)
+	if err != nil {
+		return historyCommandError(err)
+	}
+	if !json.Valid(data) {
+		return historyCommandError(fmt.Errorf("historical state version %d is not valid JSON", version))
+	}
+
+	if args.JSON {
+		_, _ = os.Stdout.Write(data)
+		if len(data) == 0 || data[len(data)-1] != '\n' {
+			fmt.Fprintln(os.Stdout)
+		}
+		return 0
+	}
+
+	versions, err := history.ListVersions(ctx)
+	if err != nil {
+		return historyCommandError(err)
+	}
+	var metadata *statemgr.StateVersion
+	for i := range versions {
+		if versions[i].Version == version {
+			metadata = &versions[i]
+			break
+		}
+	}
+
+	updated, digest := "-", "-"
+	if metadata != nil {
+		digest = metadata.Digest
+		if !metadata.UpdatedAt.IsZero() {
+			updated = metadata.UpdatedAt.UTC().Format(time.RFC3339)
+		}
+	}
+
+	var pretty bytes.Buffer
+	if err := json.Indent(&pretty, data, "", "  "); err != nil {
+		return historyCommandError(err)
+	}
+	fmt.Fprintf(os.Stdout, "Version: %d\nUpdated: %s\nDigest: %s\n\n%s\n", version, updated, digest, pretty.String())
+	return 0
+}
+
+func HistoryPullCommander() Command {
+	cmd := Command{Name: "pull", Short: "Write a retained state version to a file", Long: "Write one retained state version to a new file."}
+	args := arguments.BindHistoryPull(&cmd.CommandLine)
+	cmd.Run = func(meta Meta) int { return HistoryPullCommand{Meta: meta}.Execute(args) }
+	return cmd
+}
+
+type HistoryPullCommand struct{ Meta }
+
+func (c *HistoryPullCommand) Synopsis() string { return "Write a retained state version to a file" }
+func (c *HistoryPullCommand) Help() string {
+	return strings.TrimSpace(`
+Usage: tofu [global options] history pull -output=<file> <version>
+
+  Write one retained state version to a new file. Existing files are not
+  overwritten.
+`)
+}
+func (c *HistoryPullCommand) Run(rawArgs []string) int {
+	return RunCommand(HistoryPullCommander(), c.Meta, normalizeHistoryArgs(rawArgs))
+}
+func (c HistoryPullCommand) Execute(args *arguments.HistoryPull) int {
+	if strings.TrimSpace(args.Output) == "" {
+		return historyCommandError(fmt.Errorf("history pull requires -output=<file>"))
+	}
+	version, err := parseHistoryVersion(args.Version)
+	if err != nil {
+		return historyCommandError(err)
+	}
+
+	ctx, history, err := loadStateHistory(c.Meta)
+	if err != nil {
+		return historyCommandError(err)
+	}
+	data, err := history.GetVersion(ctx, version)
+	if err != nil {
+		return historyCommandError(err)
+	}
+
+	f, err := os.OpenFile(args.Output, os.O_WRONLY|os.O_CREATE|os.O_EXCL, 0o600)
+	if err != nil {
+		return historyCommandError(err)
+	}
+	if _, err := f.Write(data); err != nil {
+		_ = f.Close()
+		_ = os.Remove(args.Output)
+		return historyCommandError(err)
+	}
+	if err := f.Close(); err != nil {
+		_ = os.Remove(args.Output)
+		return historyCommandError(err)
+	}
+	fmt.Fprintf(os.Stdout, "Wrote state version %d to %s\n", version, args.Output)
+	return 0
+}
+
+func loadStateHistory(meta Meta) (context.Context, statemgr.History, error) {
+	ctx := meta.CommandContext()
+	if diags := meta.checkRequiredVersion(ctx); diags.HasErrors() {
+		return nil, nil, diags.Err()
+	}
+
+	enc, diags := meta.Encryption(ctx)
+	if diags.HasErrors() {
+		return nil, nil, diags.Err()
+	}
+	b, diags := meta.Backend(ctx, nil, enc.State())
+	if diags.HasErrors() {
+		return nil, nil, diags.Err()
+	}
+	meta.ignoreRemoteVersionConflict(b)
+
+	workspace, err := meta.Workspace(ctx)
+	if err != nil {
+		return nil, nil, fmt.Errorf("selecting workspace: %w", err)
+	}
+	stateMgr, err := b.StateMgr(ctx, workspace)
+	if err != nil {
+		return nil, nil, fmt.Errorf("loading state manager: %w", err)
+	}
+	history, ok := stateMgr.(statemgr.History)
+	if !ok {
+		return nil, nil, fmt.Errorf("the active backend does not support read-only state history")
+	}
+	return ctx, history, nil
+}
+
+func parseHistoryVersion(raw string) (int, error) {
+	version, err := strconv.Atoi(raw)
+	if err != nil || version <= 0 {
+		return 0, fmt.Errorf("invalid state version %q", raw)
+	}
+	return version, nil
+}
+
+func historyCommandError(err error) int {
+	fmt.Fprintf(os.Stderr, "Error: %s\n", err)
+	return 1
+}
