+	cli.BoolVar(&ret.JSON, "json", false, "Produce machine-readable JSON output.")
+	return ret
+}
+
+type HistoryShow struct {
+	JSON    bool
+	Version string
+}
+
+func BindHistoryShow(cli *CommandLine) *HistoryShow {
+	ret := &HistoryShow{}
+	cli.BoolVar(&ret.JSON, "json", false, "Produce machine-readable JSON output.")
+	cli.PositionalArg(&ret.Version, "version", false)
+	return ret
+}
+
+type HistoryPull struct {
+	Version string
+	Output  string
+}
